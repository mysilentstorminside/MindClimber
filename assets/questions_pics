#!/usr/bin/env bash
# Κατεβάζει τις 139 εικόνες που φιλοξενούνται στη Wikimedia.
# Τρέξε το ΜΕΣΑ στον φάκελο assets/questions_pics :
#     bash download_images.sh
set -u
UA="MindClimber/1.0 (educational quiz game; contact: you@example.com)"
ok=0; fail=0
download() {
  if [ -s "$1" ]; then echo "  ήδη υπάρχει: $1"; ok=$((ok+1)); return; fi
  if curl -fsSL -A "$UA" --retry 3 --retry-delay 2 -o "$1" "$2"; then
    echo "  ✓ $1"; ok=$((ok+1))
  else echo "  ✗ ΑΠΕΤΥΧΕ: $1"; rm -f "$1"; fail=$((fail+1)); fi
  sleep 0.3
}

